{
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/node_modules/**": true,
    "**/.git/**": true,
    "**/dist/**": true,
    "**/build/**": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true
  },
  "typescript.tsserver.maxTsServerMemory": 1024,
  "typescript.tsserver.watchOptions": {
    "watchFile": "fixedPollingInterval"
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/.next": true
  }
}
