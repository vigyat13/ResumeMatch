# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_LOCKED=false

# --- LLM provider override (optional) ---
# Any OpenAI-compatible endpoint. Leave blank to use Groq.
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_PROVIDER=
AI_MODEL=
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=

# --- Auth (optional: Google One Tap) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Job search (optional) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=

# --- Email (optional) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Assisted form fill (optional) ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
LOCAL_CDP_URL=

# --- Rate limiting (optional) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
